@using AvantiPoint.Packages.UI.Components
@using AvantiPoint.Packages.Protocol.Models
@using NuGet.Versioning
@namespace AvantiPoint.Packages.UI.BrowserFixture
<PackageDetail Package="package" Tab="@Tab" />
@code {
    [Microsoft.AspNetCore.Components.Parameter] public string Id { get; set; } = "AppPortal.Cli";
    [Microsoft.AspNetCore.Components.Parameter] public string? Version { get; set; }
    [Microsoft.AspNetCore.Components.Parameter] public string? Tab { get; set; }
    private PackageInfoCollection package = null!;
    protected override void OnParametersSet()
    {
        package = new PackageInfoCollection(Version ?? "3.0.52") { Versions = Enumerable.Range(1, 60).Select(i => new PackageInfo
        {
            PackageId = Id, Version = NuGetVersion.Parse($"3.0.{i}"), Authors = ["Brian", "Dan Siegel"],
            IsListed = true, HasReadme = true, HasEmbeddedLicense = Id == "AppPortal.Cli",
            LicenseExpression = Id == "AppPortal.Cli" ? "AvantiPoint-Custom" : "MIT", Description = $"Synthetic {Id} {i}",
            RepositoryUrl = "https://example.test/source", ProjectUrl = "https://example.test/website",
            TargetFrameworks = ["net10.0"], Published = DateTimeOffset.UtcNow.AddDays(-i),
            Dependencies = new() { ["net10.0"] = Enumerable.Range(1, 12).Select(d => new PackageDependencyInfo { PackageId = $"Dependency.{d}", VersionRange = $"[{i}.0.0]", IsLocalDependency = true }) }
        }).ToList() };
    }
}
