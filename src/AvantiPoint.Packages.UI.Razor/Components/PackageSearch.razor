@using AvantiPoint.Packages.UI.Services
@using AvantiPoint.Packages.Protocol.Models
@using Microsoft.AspNetCore.Components.Web
@using System.Net.Http
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.Json.Serialization
@using System.Globalization

@namespace AvantiPoint.Packages.UI.Components
@inject INuGetSearchService SearchService
@inject IHttpClientFactory? HttpClientFactory
@inject NavigationManager NavigationManager

<div class="nuget-theme-scope w-full">
    <div class="mb-3">
        <div class="flex w-full">
            <input type="text" class="min-h-11 flex-1 rounded-l-md border border-border bg-surface px-3 text-fg" placeholder="@Placeholder" @bind="searchQuery" @bind:event="oninput"
                @onkeydown="HandleKeyDown" />
            <button class="inline-flex min-h-11 items-center rounded-r-md border border-brand bg-brand px-4 font-semibold text-white hover:bg-brand-strong disabled:opacity-60" @onclick="PerformSearch" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="inline-block size-4 animate-spin rounded-full border-2 border-white/30 border-t-white" role="status" aria-hidden="true"></span>
                    <span class="ml-1">Searching...</span>
                }
                else
                {
                    <span>Search</span>
                }
            </button>
        </div>
    </div>
    <div class="flex flex-col gap-3 md:flex-row">
        <aside class="w-full rounded-xl border border-border bg-panel p-5 shadow-pkg md:sticky md:top-5 md:w-1/4" id="filters-column">
            <div class="mb-3 flex items-center justify-between rounded-lg border border-border bg-panel px-4 py-3 font-semibold md:hidden">
                <span>Advanced search filters</span>
                <button class="rounded-full border border-border px-3 py-1 text-fg hover:border-brand hover:text-brand"
                    aria-label="Toggles search filters on narrow screens"
                    aria-expanded="@advancedSearchExpanded.ToString().ToLower()" aria-controls="advancedSearchPanel"
                    @onclick="ToggleAdvancedSearch" tabindex="0" type="button">
                    <i class="ms-Icon @(advancedSearchExpanded ? "ms-Icon--ChevronUp" : "ms-Icon--ChevronDown")"
                        id="advancedSearchToggleChevron"></i>
                </button>
            </div>
            <div class="@(advancedSearchExpanded ? "block" : "hidden") md:block"
                id="advancedSearchPanel">
                <div>
                    <fieldset id="frameworkfilters">
                        <legend>
                            Frameworks
                            <span class="info-helper">
                                <button class="info-icon" type="button" aria-label="What does the framework filter do?"
                                    aria-describedby="frameworksfiltersid">
                                    i
                                </button>
                                <span class="info-tooltip" role="tooltip" id="frameworksfiltersid">
                                    Filters packages based on the target frameworks they are compatible with.
                                </span>
                            </span>
                            <a href="https://learn.microsoft.com/nuget/consume-packages/finding-and-choosing-packages#advanced-filtering-and-sorting?linkid=2083908&WT.mc_id=DT-MVP-5002924"
                                class="frameworkfilters-info"
                                aria-label="Learn more about advanced filtering and sorting">Learn more</a>
                        </legend>
                        <div class="computed-frameworks-option">
                            <span class="mini-label">Include compatible frameworks</span>
                            <label for="computed-frameworks-checkbox" class="brand-checkbox"
                                aria-label="Include computed compatible frameworks when filtering for packages.">
                                <input type="checkbox" id="computed-frameworks-checkbox"
                                    @bind="includeCompatibleFrameworks" />
                            </label>
                        </div>
                        <div class="framework-filter-mode-option">
                            <div class="mini-label-row">
                                <span class="mini-label">Framework Filter Mode
                                    <span class="info-helper">
                                        <button class="info-icon" type="button"
                                            aria-label="Framework filter mode explanation"
                                            aria-describedby="frameworkfiltermodeid">i</button>
                                        <span class="info-tooltip" role="tooltip" id="frameworkfiltermodeid">
                                            Choose whether packages must match all selected TFMs or any of them.
                                        </span>
                                    </span>
                                </span>
                                <div class="toggle-switch-control" role="radiogroup"
                                    aria-label="Select how framework filters are combined">
                                    <input type="radio" class="toggle-switch-radio" id="framework-filter-all"
                                        name="frameworkFilterMode" value="all" checked="@(frameworkFilterMode == "all")"
                                        @onchange='@(e => frameworkFilterMode = "all")' />
                                    <label class="toggle-switch-label" for="framework-filter-all">ALL</label>
                                    <input type="radio" class="toggle-switch-radio" id="framework-filter-any"
                                        name="frameworkFilterMode" value="any" checked="@(frameworkFilterMode == "any")"
                                        @onchange='@(e => frameworkFilterMode = "any")' />
                                    <label class="toggle-switch-label" for="framework-filter-any">ANY</label>
                                </div>
                            </div>
                        </div>
                        @foreach (var group in frameworkGroups)
                        {
                            var groupCss = group.Expanded ? "expanded" : "collapsed";
                            <div class="frameworkGroup @groupCss">
                                <div class="frameworkGroupRow">
                                    <button type="button" class="collapse-toggle" aria-controls="@(group.Id)tab"
                                        aria-expanded="@group.Expanded.ToString().ToLower()"
                                        @onclick="() => ToggleGroup(group)">
                                        <span class="chevron @(group.Expanded ? "chevron-open" : "chevron-closed")"></span>
                                    </button>
                                    <label class="brand-checkbox fw-group-select">
                                        <input type="checkbox" id="@group.Id" class="framework" checked="@group.Selected"
                                            @onchange="e => OnGroupSelectionChanged(group, e)" />
                                        <span class="fw-group-label">@group.Label</span>
                                    </label>
                                </div>
                                <div class="tfmTab" id="@(group.Id)tab">
                                    <ul>
                                        @foreach (var tfm in group.TargetFrameworks)
                                        {
                                            <li>
                                                <label class="brand-checkbox">
                                                    <input type="checkbox" id="@tfm.Id" class="tfm" parent="@group.Id"
                                                        checked="@tfm.Selected"
                                                        @onchange="e => OnTfmSelectionChanged(group, tfm, e)" />
                                                    <span>@tfm.Label</span>
                                                </label>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        }
                    </fieldset>
                </div>
                <div>
                    <fieldset id="packagetype">
                        <legend>Package type</legend>
                        <div style="display: flex;">
                            <label aria-label="Package Type: All types" class="brand-radio">
                                <input type="radio" name="packagetype" value="" checked="@(selectedPackageType == null)"
                                    @onchange="@(e => selectedPackageType = null)">
                                <span>All types</span>
                            </label>
                        </div>
                        <div style="display: flex;">
                            <label aria-label="Package Type: Dependency" class="brand-radio">
                                <input type="radio" name="packagetype" value="dependency"
                                    checked="@(selectedPackageType == "dependency")"
                                    @onchange='@(e => selectedPackageType = "dependency")'>
                                <span>Dependency</span>
                            </label>
                        </div>
                        <div style="display: flex;">
                            <label aria-label="Package Type: .NET tool" class="brand-radio">
                                <input type="radio" name="packagetype" value="dotnettool"
                                    checked="@(selectedPackageType == "dotnettool")"
                                    @onchange='@(e => selectedPackageType = "dotnettool")'>
                                <span>.NET tool</span>
                            </label>
                        </div>
                        <div style="display: flex;">
                            <label aria-label="Package Type: Template" class="brand-radio">
                                <input type="radio" name="packagetype" value="template"
                                    checked="@(selectedPackageType == "template")"
                                    @onchange='@(e => selectedPackageType = "template")'>
                                <span>Template</span>
                            </label>
                        </div>
                        <div style="display: flex;">
                            <label aria-label="Package Type: MCP Server" class="brand-radio">
                                <input type="radio" name="packagetype" value="mcpserver"
                                    checked="@(selectedPackageType == "mcpserver")"
                                    @onchange='@(e => selectedPackageType = "mcpserver")'>
                                <span>MCP Server</span>
                            </label>
                        </div>
                    </fieldset>
                </div>
                <!-- Options -->
                <div>
                    <fieldset>
                        <legend>Options</legend>
                        <div class="prerel-option">
                            <label class="brand-checkbox" aria-label="Options: Include prerelease">
                                <input id="prerel-checkbox" type="checkbox" @bind="includePrerelease">
                                <span>Include prerelease</span>
                            </label>
                        </div>
                    </fieldset>
                </div>
                <!-- Apply/Reset Buttons -->
                <div class="mt-3 grid grid-cols-2 gap-3">
                    <div class="apply-btn">
                        <button class="btn-full inline-flex w-full items-center justify-center rounded-full border border-brand bg-brand px-5 py-2.5 text-xs font-semibold tracking-wide text-white hover:bg-brand-strong" type="button" @onclick="ApplyFilters">Apply</button>
                    </div>
                    <div class="reset-btn">
                        <button class="btn-full inline-flex w-full items-center justify-center rounded-full border border-border bg-transparent px-5 py-2.5 text-xs font-semibold text-fg hover:border-brand hover:text-brand" type="button"
                            @onclick="ResetFilters">Reset</button>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="min-w-0 flex-1">

            @if (errorMessage != null)
            {
                <div class="mb-3 rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-red-800 dark:border-red-800 dark:bg-red-950 dark:text-red-200" role="alert">
                    @errorMessage
                </div>
            }

            @if (isNavigatingToPackage && navigationPreview is not null)
            {
                <div class="search-results" role="status" aria-live="polite">
                    <div class="flex flex-col gap-4 rounded-2xl border border-border bg-panel p-5 shadow-pkg">
                        <div class="pointer-events-none opacity-85">
                            <PackageSearchResultItem Package="navigationPreview" />
                        </div>
                        <div class="inline-flex items-center gap-3 font-semibold text-fg">
                            <span class="inline-block size-4 animate-spin rounded-full border-2 border-white/30 border-t-white" role="presentation" aria-hidden="true"></span>
                            <span>Opening package details…</span>
                        </div>
                    </div>
                </div>
            }
            else if (isLoading)
            {
                <div class="search-results" aria-hidden="true">
                    <div class="mb-3 flex flex-col gap-3">
                        @for (int i = 0; i < 5; i++)
                        {
                            <div class="block">
                                <PackageSearchResultSkeleton />
                            </div>
                        }
                    </div>
                </div>
            }
            else if (searchResults != null)
            {
                <div class="search-results">
                    <div class="mb-3 flex items-center justify-between">
                        <div class="text-fg-secondary">
                            @if (searchResults.TotalHits == 0)
                            {
                                <text>No packages found</text>
                            }
                            else if (searchResults.TotalHits == 1)
                            {
                                <text>1 package</text>
                            }
                            else
                            {
                                <text>@searchResults.TotalHits.ToString("N0") packages</text>
                            }
                        </div>
                    </div>

                    @if (searchResults.Data?.Count > 0)
                    {
                        <div class="mb-3 flex flex-col gap-3">
                            @foreach (var package in searchResults.Data)
                            {
                                <div class="block">
                                    <PackageSearchResultItem Package="package" OnPackageClick="HandlePackageClick" />
                                </div>
                            }
                        </div>

                        @if (HasMoreResults || currentPage > 0)
                        {
                            <nav class="flex items-center justify-between" aria-label="Pagination">
                                <button class="rounded-md border border-border bg-surface px-3 py-1.5 text-sm font-semibold text-fg hover:border-brand hover:text-brand disabled:opacity-50" @onclick="LoadPreviousPage"
                                    disabled="@(currentPage == 0 || isLoading)">
                                    ← Previous
                                </button>
                                <span class="text-sm text-fg-secondary">Page @(currentPage + 1)</span>
                                <button class="rounded-md border border-border bg-surface px-3 py-1.5 text-sm font-semibold text-fg hover:border-brand hover:text-brand disabled:opacity-50" @onclick="LoadNextPage"
                                    disabled="@(!HasMoreResults || isLoading)">
                                    Next →
                                </button>
                            </nav>
                        }
                    }
                </div>
            }
        </main>
    </div>
</div>

@code {
    private const string FrameworkManifestPath = "_content/AvantiPoint.Packages.UI.Razor/data/frameworks.json";
    private static readonly JsonSerializerOptions FrameworkSerializerOptions = CreateFrameworkSerializerOptions();

    private string searchQuery = "";
    private bool includePrerelease = false;
    private bool includeCompatibleFrameworks = true;
    private string? selectedPackageType = null;
    private string frameworkFilterMode = "all";
    private bool advancedSearchExpanded = true;
    private bool isLoading = false;
    private bool isNavigatingToPackage = false;
    private SearchResult? navigationPreview;
    private string? errorMessage = null;
    private SearchResponse? searchResults = null;
    private int currentPage = 0;
    private const int PageSize = 20;

    private List<FrameworkGroup> frameworkGroups = new();

    [Parameter]
    public string Placeholder { get; set; } = "Search packages...";

    [Parameter]
    public int ResultsPerPage { get; set; } = 20;

    private bool HasMoreResults =>
    searchResults != null &&
    ((currentPage + 1) * ResultsPerPage) < searchResults.TotalHits;

    protected override async Task OnInitializedAsync()
    {
        await EnsureFrameworkGroupsLoadedAsync();
        await PerformSearch();
    }

    private async Task EnsureFrameworkGroupsLoadedAsync()
    {
        if (frameworkGroups.Count > 0)
        {
            return;
        }

        try
        {
            var definitions = await LoadFrameworkDefinitionsAsync();
            if (definitions?.Count > 0)
            {
                frameworkGroups = definitions
                .Select(MapToFrameworkGroup)
                .ToList();
                return;
            }
        }
        catch
        {
            // Swallow and fall back to baked-in defaults to keep the UI usable
        }

        frameworkGroups = GetDefaultFrameworkGroups();
    }

    private async Task<List<FrameworkGroupDefinition>?> LoadFrameworkDefinitionsAsync()
    {
        var httpClient = HttpClientFactory?.CreateClient() ?? new HttpClient();
        var shouldDispose = HttpClientFactory is null;

        try
        {
            if (httpClient.BaseAddress is null)
            {
                httpClient.BaseAddress = new Uri(NavigationManager.BaseUri);
            }

            return await httpClient.GetFromJsonAsync<List<FrameworkGroupDefinition>>(FrameworkManifestPath,
            FrameworkSerializerOptions);
        }
        finally
        {
            if (shouldDispose)
            {
                httpClient.Dispose();
            }
        }
    }

    private static FrameworkGroup MapToFrameworkGroup(FrameworkGroupDefinition definition)
    {
        var targets = definition.Tfms
        .Select(t => new TargetFramework
        {
            Id = t.Tfm,
            Label = t.Display
        })
        .ToList();

        return new FrameworkGroup
        {
            Id = definition.GroupId,
            Label = definition.Label,
            Expanded = string.Equals(definition.GroupId, "net", StringComparison.OrdinalIgnoreCase),
            TargetFrameworks = targets
        };
    }

    private static List<FrameworkGroup> GetDefaultFrameworkGroups() => new()
{
new FrameworkGroup
{
