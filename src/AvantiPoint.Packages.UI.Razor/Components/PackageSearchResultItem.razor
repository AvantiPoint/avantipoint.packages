@using AvantiPoint.Packages.Protocol.Models

@namespace AvantiPoint.Packages.UI.Components
@inject NavigationManager Navigation

<a href="@GetPackageHref()" class="group flex cursor-pointer gap-4 rounded-xl border border-pkg-border bg-pkg px-5 py-4 no-underline transition hover:-translate-y-px hover:border-pkg-hover hover:shadow-pkg" role="listitem"
    aria-label="Package @(Package.PackageId)">
    <div class="pkg-icon-shell flex size-11 shrink-0 items-center justify-center overflow-hidden rounded-[10px] border border-pkg-border bg-pkg-icon" aria-hidden="true">
        @if (!string.IsNullOrEmpty(Package.IconUrl))
        {
            <img src="@(Package.IconUrl)" alt="@(Package.PackageId) icon" class="pkg-icon-contrast block size-full max-h-11 max-w-11 object-contain p-1"
                onerror="this.onerror=null;this.src='_content/AvantiPoint.Packages.UI.Razor/img/default-package-icon-256x256.png'" />
        }
        else
        {
            <img src="_content/AvantiPoint.Packages.UI.Razor/img/default-package-icon-256x256.png" alt="@(Package.PackageId) icon" class="pkg-icon-contrast block size-full max-h-11 max-w-11 object-contain p-1" />
        }
    </div>
    <div class="min-w-0 flex-1">
        <div class="mb-1 flex flex-wrap items-center gap-2">
            <h3 class="m-0 min-w-0 max-w-full break-all text-[1.05rem] font-semibold leading-tight text-pkg-title group-hover:text-pkg-title-hover" title="@(Package.PackageId)">
                @if (!string.IsNullOrEmpty(Package.Title))
                {
                    @Package.Title
                }
                else
                {
                    @Package.PackageId
                }
            </h3>
            <span class="rounded border border-chip-border bg-chip px-1.5 py-0.5 text-xs font-semibold text-pkg-title" data-version="@(Package.Version)">@(Package.Version)</span>
            @if (IsPrerelease(Package.Version))
            {
                <span class="rounded border border-amber-400 bg-amber-100 px-1.5 py-1 text-[0.65rem] font-semibold uppercase tracking-wide text-amber-800 dark:bg-amber-950 dark:text-amber-300" title="Prerelease version">pre</span>
            }
            @if (Package.Verified == true)
            {
                <span class="rounded border border-blue-400 bg-blue-50 px-1.5 py-1 text-[0.65rem] font-semibold uppercase tracking-wide text-blue-800 dark:border-blue-700 dark:bg-blue-950/50 dark:text-blue-200"
                      title="The package ID belongs to a verified reserved prefix">✓ Verified owner</span>
            }
            @if (VulnerabilityCount > 0)
            {
                <span class="rounded border border-red-400 bg-red-50 px-1.5 py-1 text-[0.65rem] font-semibold uppercase tracking-wide text-red-800 dark:border-red-800 dark:bg-red-950/50 dark:text-red-200"
                      title="@VulnerabilityTitle">@VulnerabilityLabel</span>
            }
            @if (Package.PackageTypes?.Count > 0)
            {
                <span class="rounded border border-tag-border bg-tag px-1.5 py-1 text-[0.65rem] font-semibold uppercase tracking-wide text-tag-fg"
                    title="@(Package.PackageTypes[0].Name) package type">@Package.PackageTypes[0].Name</span>
                @if (Package.PackageTypes.Count > 1)
                {
                    <span class="rounded border border-chip-border bg-tag-more px-1.5 py-1 text-[0.65rem] font-semibold uppercase tracking-wide text-tag-more-fg"
                        title="Additional package types">+@((Package.PackageTypes.Count - 1))</span>
                }
            }
        </div>
        @if (!string.IsNullOrEmpty(Package.Description))
        {
            <p class="mb-2 mt-1 line-clamp-2 text-sm leading-snug text-pkg-body" title="@(Package.Description)">@(Package.Description)</p>
        }
        else if (!string.IsNullOrEmpty(Package.Summary))
        {
            <p class="mb-2 mt-1 line-clamp-2 text-sm leading-snug text-pkg-body" title="@(Package.Summary)">@(Package.Summary)</p>
        }
        <div class="mb-2 flex flex-wrap gap-2">
            @if (Package.Authors?.Count > 0)
            {
                <span class="inline-flex items-center gap-1 whitespace-nowrap rounded-full border border-chip-border bg-chip px-2.5 py-1 text-[0.65rem] font-medium text-chip-fg" title="Authors">
                    <svg viewBox="0 0 24 24" class="size-3.5" aria-hidden="true">
                        <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 9a7 7 0 0 1 14 0H5Z" fill="currentColor" />
                    </svg>
                    <span class="">@(string.Join(", ", Package.Authors.Take(3)))@((Package.Authors.Count > 3) ? ", +" + (Package.Authors.Count - 3) : "")</span>
                </span>
            }
            <span class="inline-flex items-center gap-1 whitespace-nowrap rounded-full border border-chip-accent-border bg-chip-accent px-2.5 py-1 text-[0.65rem] font-medium text-chip-accent-fg" title="Total downloads">
                <svg viewBox="0 0 24 24" class="size-3.5" aria-hidden="true">
                    <path d="M12 3v9m0 0 4-4m-4 4-4-4M5 21h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                </svg>
                <span class="">Downloads: @(Package.TotalDownloads.ToString("N0"))</span>
            </span>
            <span class="inline-flex items-center gap-1 whitespace-nowrap rounded-full border border-chip-border bg-chip px-2.5 py-1 text-[0.65rem] font-medium text-chip-fg" title="Published date">
                <svg viewBox="0 0 24 24" class="size-3.5" aria-hidden="true">
                    <path d="M7 3v4m10-4v4M5 7h14v12a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V7Zm2 5h10" stroke="currentColor"
                        stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                </svg>
                <span class="">@(Package.Published.UtcDateTime.ToString("yyyy-MM-dd"))</span>
            </span>
        </div>
        @if (Package.Tags?.Count > 0)
        {
            <div class="mt-1 flex flex-wrap gap-1.5" aria-label="Tags">
                @foreach (var tag in Package.Tags.Take(6))
                {
                    <span class="inline-flex items-center rounded-full border border-tag-border bg-tag px-2 py-1 text-[0.6rem] font-semibold tracking-wide text-tag-fg" title="Tag: @(tag)">@(tag)</span>
                }
                @if (Package.Tags.Count > 6)
                {
                    <span class="inline-flex items-center rounded-full border border-chip-border bg-tag-more px-2 py-1 text-[0.6rem] font-semibold tracking-wide text-tag-more-fg" title="Additional tags">+@(@Package.Tags.Count - 6)</span>
                }
            </div>
        }
    </div>
</a>

@code {
    [Parameter, EditorRequired]
    public SearchResult Package { get; set; } = default!;

    [Parameter]
    public EventCallback<SearchResult> OnPackageClick { get; set; }

    private string GetPackageHref()
    {
        if (Package is null || string.IsNullOrWhiteSpace(Package.PackageId))
        {
            return "#";
        }

        var destination = $"/packages/{Uri.EscapeDataString(Package.PackageId)}";
        if (!string.IsNullOrWhiteSpace(Package.Version))
        {
            destination += $"/{Uri.EscapeDataString(Package.Version)}";
        }

        return FeedUiPath.ToHref(Navigation, destination);
    }

    private static bool IsPrerelease(string version)
    => !string.IsNullOrEmpty(version) && version.Contains('-', StringComparison.Ordinal);

    private int VulnerabilityCount => Package.Vulnerabilities?.Count ?? 0;

    private string VulnerabilityLabel => VulnerabilityCount == 1
        ? "1 known vulnerability"
        : $"{VulnerabilityCount} known vulnerabilities";

    private string VulnerabilityTitle
    {
        get
        {
            var severities = Package.Vulnerabilities?
                .Select(static vulnerability => vulnerability.Severity)
                .Where(static severity => !string.IsNullOrWhiteSpace(severity))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToArray() ?? [];
            return severities.Length == 0
                ? VulnerabilityLabel
                : $"{VulnerabilityLabel}; reported severity: {string.Join(", ", severities)}";
        }
    }
}
