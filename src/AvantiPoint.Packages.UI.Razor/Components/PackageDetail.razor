@using AvantiPoint.Packages.Protocol.Models
@using NuGet.Versioning
@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Configuration
@using Humanizer
@using Markdig
@using System.Net.Http

@namespace AvantiPoint.Packages.UI.Components
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IHttpClientFactory HttpClientFactory
@inject IConfiguration Configuration
@inject IPackageDiffService DiffService
@inject IServiceProvider Services
@implements IAsyncDisposable

<div class="nuget-theme-scope" data-enhance-nav="false" data-package-path="@PackageBaseUrl" @ref="detailRoot">
    <p><a href="@AvantiPoint.Packages.UI.Services.FeedUiPath.ToHref(NavigationManager, "/")">← NuGet packages</a></p>
    @if (packageVersions.Count == 0)
    {
        <section class="rounded-2xl border border-dashed border-border bg-panel p-6 text-center text-fg-secondary" role="status">
            <p>No package metadata available.</p>
        </section>
    }
    else
    {
        <article class="rounded-2xl border border-border bg-panel p-6 text-fg">
            <header class="mb-6 flex flex-wrap items-start justify-between gap-6 max-md:flex-col">
                <div class="flex items-center gap-4 max-md:flex-col max-md:items-start">
                    <img src="@IconSource" class="pkg-icon-contrast pkg-icon-shell rounded-lg border border-border bg-pkg-icon p-1" width="64" height="64"
                        alt="@($"Icon for {DetailPackageId}")" onerror="this.onerror=null;this.src='@DefaultIconPath';" />
                    <div>
                        <div class="flex flex-col gap-1">
                            <h1 class="m-0 break-all text-2xl font-semibold"><a class="text-fg no-underline hover:text-brand" href="@PackageBaseUrl">@DetailPackageId</a></h1>
                            @if (SelectedPackageVersion!.Authors?.Any() == true)
                            {
                                <small class="text-fg-secondary">by @string.Join(", ", SelectedPackageVersion!.Authors)</small>
                            }
                        </div>
                        <div class="mt-3 flex flex-wrap items-center gap-3 max-md:flex-col max-md:items-start">
                            <div class="relative min-w-60 max-md:w-full">
                                <label for="@versionPickerId" class="sr-only">Package version</label>
                                <select id="@versionPickerId" class="package-version-select" @bind:get="SelectedVersionString" @bind:set="VersionChangedAsync">
                                    @foreach (var group in VersionGroups)
                                    {
                                        <optgroup label="Version @group.Major">
                                            @foreach (var info in group.Items)
                                            {
                                                <option value="@info.Version?.OriginalVersion">@info.Version?.OriginalVersion</option>
                                            }
                                        </optgroup>
                                    }
                                </select>
                            </div>
                            <span class="text-sm text-fg-secondary">
                                Published @FormatHumanizedDate(SelectedPackageVersion?.Published) <br />
                                <span
                                    class="text-fg-secondary">(@FormatAbsoluteDate(SelectedPackageVersion?.Published))</span>
                            </span>
                        </div>

                        @if (SelectedPackageVersion!.Tags?.Any() == true)
                        {
                            <div class="mt-3 flex flex-wrap gap-2" aria-label="Package tags">
                                @foreach (var tag in SelectedPackageVersion!.Tags)
                                {
                                    if (!string.IsNullOrWhiteSpace(tag))
                                    {
                                        <span class="rounded border border-border bg-surface px-2 py-0.5 text-xs font-medium text-fg-secondary">@tag</span>
                                    }
                                }
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(SelectedPackageVersion!.Description) && !SelectedPackageVersion!.Description.Equals("Package                    Description", StringComparison.OrdinalIgnoreCase))
                        {
                            <p class="mt-4 mb-0 text-lg leading-relaxed text-fg">@SelectedPackageVersion!.Description</p>
                        }

                        @if (SelectedFrameworks.Count > 0)
                        {
                            <div class="mt-3 flex flex-wrap gap-2" aria-label="Target frameworks">
                                @foreach (var tfm in SelectedFrameworks)
                                {
                                    <span class="rounded border border-border bg-surface px-2 py-0.5 text-xs font-medium text-fg">@tfm</span>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="package-actions" role="group" aria-label="Package quick links">
                    @if (SafeWebUrl(SelectedPackageVersion!.ProjectUrl) is { } projectUrl)
                    {
                        <a href="@projectUrl" class="package-action" rel="noopener noreferrer" target="_blank" title="Open project website (new tab)">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c6 6 6 12 0 18-6-6-6-12 0-18Z" /></svg>
                            <span>Website</span>
                        </a>
                    }
                    @if (SafeWebUrl(SelectedPackageVersion!.RepositoryUrl) is { } repositoryUrl)
                    {
                        <a href="@repositoryUrl" class="package-action" rel="noopener noreferrer" target="_blank" title="Open source repository (new tab)">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m8 6-6 6 6 6m8-12 6 6-6 6M14 3l-4 18" /></svg>
                            <span>Source</span>
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(LicenseDisplay.Text))
                    {
                        @if (LicenseDisplay.Url is { } licenseUrl)
                        {
                            <a href="@licenseUrl" class="package-action" rel="noopener noreferrer" target="_blank" title="View license: @LicenseDisplay.Text (new tab)">
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 3h9l4 4v14H5V3Zm3 8h6m-6 4h6M14 3v5h5" /></svg>
                                <span>@LicenseDisplay.Text</span>
                            </a>
                        }
                        else
                        {
                            <button type="button" class="package-action" @onclick="ShowLicenseAsync" aria-haspopup="dialog">
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 3h9l4 4v14H5V3Zm3 8h6m-6 4h6M14 3v5h5" /></svg>
                                <span>@LicenseDisplay.Text</span>
                            </button>
                        }
                    }
                </div>
            </header>

            @if (SelectedPackageVersion?.IsDeprecated == true)
            {
                <section class="mb-6 rounded-xl border border-amber-400 bg-amber-50 p-4 text-amber-950 dark:border-amber-700 dark:bg-amber-950/40 dark:text-amber-100" role="alert">
                    <h2 class="m-0 text-base">This package version is deprecated</h2>
                    @if (!string.IsNullOrWhiteSpace(SelectedPackageVersion.DeprecationMessage))
                    {
                        <p class="mb-0 mt-1 whitespace-pre-wrap text-sm">@SelectedPackageVersion.DeprecationMessage</p>
                    }
                    else
                    {
                        <p class="mb-0 mt-1 text-sm">The publisher marked @DetailPackageId @SelectedVersionString as deprecated. Review the release notes and available versions before adding it to a project.</p>
                    }
                    @if (SelectedPackageVersion.DeprecationReasons.Count > 0)
                    {
                        <p class="mb-0 mt-2 text-xs font-semibold uppercase tracking-wide">Reasons: @string.Join(", ", SelectedPackageVersion.DeprecationReasons)</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(SelectedPackageVersion.DeprecatedAlternatePackageId))
                    {
                        <p class="mb-0 mt-2 text-sm">
                            Suggested replacement:
                            <a class="font-semibold text-current underline" href="@AlternatePackageHref">@SelectedPackageVersion.DeprecatedAlternatePackageId</a>
                            @if (!string.IsNullOrWhiteSpace(SelectedPackageVersion.DeprecatedAlternatePackageVersionRange))
                            {
                                <span> @SelectedPackageVersion.DeprecatedAlternatePackageVersionRange</span>
                            }
                        </p>
                    }
                </section>
            }

            <div class="flex items-start gap-8 max-md:flex-col">
                <section class="min-w-0 flex-1">
                    <section class="mb-8" aria-label="Installation instructions">
                        @if (SelectedPackageVersion!.IsTool)
                        {
                            <div class="install-snippet">
                                <div class="install-snippet__header">
                                    <h5>.NET tool</h5>
                                    <button type="button" class="install-snippet__copy" aria-label="Copy .NET tool command"
                                        @onclick="() => CopyCommandAsync(ToolCommand)">
                                        Copy
                                    </button>
                                </div>
                                <pre><code>@ToolCommand</code></pre>
                            </div>
                        }
                        else if (SelectedPackageVersion!.IsTemplate)
                        {
                            <div class="install-snippet">
                                <div class="install-snippet__header">
                                    <h5>Template</h5>
                                    <button type="button" class="install-snippet__copy" aria-label="Copy template command"
                                        @onclick="() => CopyCommandAsync(TemplateCommand)">
                                        Copy
                                    </button>
                                </div>
                                <pre><code>@TemplateCommand</code></pre>
                            </div>
                        }
                        else
                        {
                            var tabs = InstallTabs.ToList();
                            <div class="install-tabs" role="tablist" aria-label="Package install options">
                                @foreach (var tab in tabs)
                                {
                                    var isActive = ActiveInstallTab == tab.Id;
                                    <a class="install-tab @(isActive ? "active" : null)" role="tab"
                                        aria-selected="@(isActive ? "true" : "false")" data-enhance-nav="false" href="@InstallTabUrl(tab.Id)">
                                        @tab.Label
                                    </a>
                                }
                            </div>
                            <div class="install-tabpanels">
                                @foreach (var tab in tabs)
                                {
                                    var isActive = ActiveInstallTab == tab.Id;
                                    <section role="tabpanel" class="install-tabpanel @(isActive ? "active" : null)"
                                        hidden="@(!isActive)">

                                        @if (tab.Id == "cpm")
                                        {
                                            <div class="cpm-snippet-group">
                                                <div class="install-snippet xml">
                                                    <div class="install-snippet__header">
                                                        <span class="cpm-file-label">Directory.Packages.props</span>
                                                        <button type="button" class="install-snippet__copy" aria-label="Copy Directory.Packages.props snippet"
                                                            @onclick="() => CopyCommandAsync(CpmDirectoryPackagesPropsCommand)">
                                                            Copy
                                                        </button>
                                                    </div>
                                                    <pre><code>@CpmDirectoryPackagesPropsCommand</code></pre>
                                                </div>
                                                <div class="install-snippet xml">
                                                    <div class="install-snippet__header">
                                                        <span class="cpm-file-label">.csproj</span>
                                                        <button type="button" class="install-snippet__copy" aria-label="Copy .csproj snippet"
                                                            @onclick="() => CopyCommandAsync(CpmCsprojCommand)">
                                                            Copy
                                                        </button>
                                                    </div>
                                                    <pre><code>@CpmCsprojCommand</code></pre>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="install-snippet @tab.StyleClass">
                                                <div class="install-snippet__header">
                                                    <h5>@tab.Label</h5>
                                                    <button type="button" class="install-snippet__copy" aria-label="Copy @tab.Label command"
                                                        @onclick="() => CopyCommandAsync(tab.Command)">
                                                        Copy
                                                    </button>
                                                </div>
                                                <pre><code>@tab.Command</code></pre>
                                            </div>
                                        }
                                    </section>
                                }
                            </div>
                        }
                    </section>

                    <div class="mb-6 flex flex-wrap gap-8 border-b border-border" role="tablist" aria-label="Package details">
                        <a class="border-0 border-b-4 bg-transparent py-3 text-base font-semibold no-underline @(ActiveContentTab == "readme" ? "border-brand text-fg" : "border-transparent text-fg-secondary hover:text-fg")"
                            role="tab" id="@(versionPickerId + "-readme-tab")" aria-controls="@(versionPickerId + "-readme-panel")" tabindex="@(ActiveContentTab == "readme" ? 0 : -1)" aria-selected="@(ActiveContentTab == "readme" ? "true" : "false")"
                            data-enhance-nav="false" href="@ContentTabUrl("readme")">
                            ReadMe
                        </a>
                        <a class="border-0 border-b-4 bg-transparent py-3 text-base font-semibold no-underline @(ActiveContentTab == "dependencies" ? "border-brand text-fg" : "border-transparent text-fg-secondary hover:text-fg")"
                            role="tab" id="@(versionPickerId + "-dependencies-tab")" aria-controls="@(versionPickerId + "-dependencies-panel")" tabindex="@(ActiveContentTab == "dependencies" ? 0 : -1)" aria-selected="@(ActiveContentTab == "dependencies" ? "true" : "false")"
                            data-enhance-nav="false" href="@ContentTabUrl("dependencies")">
                            References and Dependencies
                        </a>
                        @if (HasReleaseNotes)
                        {
                            <a class="border-0 border-b-4 bg-transparent py-3 text-base font-semibold no-underline @(ActiveContentTab == "release-notes" ? "border-brand text-fg" : "border-transparent text-fg-secondary hover:text-fg")"
                               role="tab" id="@(versionPickerId + "-release-notes-tab")" aria-controls="@(versionPickerId + "-release-notes-panel")" tabindex="@(ActiveContentTab == "release-notes" ? 0 : -1)" aria-selected="@(ActiveContentTab == "release-notes" ? "true" : "false")"
                               data-enhance-nav="false" href="@ContentTabUrl("release-notes")">
                                Release notes
                            </a>
                        }
                        <a class="border-0 border-b-4 bg-transparent py-3 text-base font-semibold no-underline @(ActiveContentTab == "badges" ? "border-brand text-fg" : "border-transparent text-fg-secondary hover:text-fg")"
                            role="tab" id="@(versionPickerId + "-badges-tab")" aria-controls="@(versionPickerId + "-badges-panel")" tabindex="@(ActiveContentTab == "badges" ? 0 : -1)" aria-selected="@(ActiveContentTab == "badges" ? "true" : "false")"
                            data-enhance-nav="false" href="@ContentTabUrl("badges")">
                            Badges
                        </a>
                        <a class="border-0 border-b-4 bg-transparent py-3 text-base font-semibold no-underline @(ActiveContentTab == "diff" ? "border-brand text-fg" : "border-transparent text-fg-secondary hover:text-fg")"
                            role="tab" id="@(versionPickerId + "-diff-tab")" aria-controls="@(versionPickerId + "-diff-panel")" tabindex="@(ActiveContentTab == "diff" ? 0 : -1)" aria-selected="@(ActiveContentTab == "diff" ? "true" : "false")"
                            data-enhance-nav="false" href="@ContentTabUrl("diff")">
                            Diff
                        </a>
                        <a class="border-0 border-b-4 bg-transparent py-3 text-base font-semibold no-underline @(ActiveContentTab == "versions" ? "border-brand text-fg" : "border-transparent text-fg-secondary hover:text-fg")"
                            role="tab" id="@(versionPickerId + "-versions-tab")" aria-controls="@(versionPickerId + "-versions-panel")" tabindex="@(ActiveContentTab == "versions" ? 0 : -1)" aria-selected="@(ActiveContentTab == "versions" ? "true" : "false")"
                            data-enhance-nav="false" href="@ContentTabUrl("versions")">
                            Versions
                        </a>
                        <a class="border-0 border-b-4 bg-transparent py-3 text-base font-semibold no-underline @(ActiveContentTab == "frameworks" ? "border-brand text-fg" : "border-transparent text-fg-secondary hover:text-fg")"
                            role="tab" id="@(versionPickerId + "-frameworks-tab")" aria-controls="@(versionPickerId + "-frameworks-panel")" tabindex="@(ActiveContentTab == "frameworks" ? 0 : -1)" aria-selected="@(ActiveContentTab == "frameworks" ? "true" : "false")"
                            data-enhance-nav="false" href="@ContentTabUrl("frameworks")">
                            Frameworks
                        </a>
                    </div>

                    @if (ActiveContentTab == "readme")
                    {
                    <div role="tabpanel" id="@(versionPickerId + "-readme-panel")" aria-labelledby="@(versionPickerId + "-readme-tab")" tabindex="0">
                        @if (isReadmeLoading || (SelectedPackageVersion?.HasReadme == true && readmeWork is null && string.IsNullOrEmpty(ReadmeHtml)))
                        {
                            <p role="status">Loading ReadMe…</p>
                        }
                        else if (!string.IsNullOrWhiteSpace(ReadmeHtml))
                        {
                            <div class="pkg-readme overflow-x-auto rounded-lg border border-border bg-surface p-4">
                                @((MarkupString)ReadmeHtml)
                            </div>
                        }
                        else
                        {
                            <div class="text-fg-secondary">
                                @if (IsSelectedLiveUpstream)
                                {
                                    <p>README content is not fetched as part of this metadata-only upstream preview.</p>
                                }
                                else
                                {
                                    <p>No ReadMe available.</p>
                                }
                            </div>
                        }
                    </div>
                    }

                    @if (ActiveContentTab == "dependencies")
                    {
                    <div role="tabpanel" id="@(versionPickerId + "-dependencies-panel")" aria-labelledby="@(versionPickerId + "-dependencies-tab")" tabindex="0">
                        @if (SelectedPackageVersion!.Dependencies?.Any() == true)
                        {
                            <section class="space-y-4">
                                @foreach (var framework in SelectedPackageVersion!.Dependencies.OrderBy(x => x.Key))
                                {
                                    var validDeps = framework.Value?
                                        .Where(d => !string.IsNullOrWhiteSpace(d.PackageId) &&
                                                    !string.IsNullOrWhiteSpace(d.VersionRange))
                                        .OrderBy(d => d.PackageId)
                                        .ToList();

                                    <table class="mt-2 w-full border-collapse">
                                        <thead>
                                            <tr>
                                                <th colspan="3" class="border-b-2 border-border bg-surface font-semibold text-fg">@framework.Key</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (validDeps?.Any() == true)
                                            {
                                                @foreach (var dep in validDeps)
                                                {
                                                    <DependencyRow Dependency="@dep" GetLocalPackageUrl="@GetLocalPackageUrl" />
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="3" class="text-muted">No dependencies.</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                            </section>
                        }
                        else
                        {
                            <p>No dependencies.</p>
                        }
                    </div>
                    }

                    @if (HasReleaseNotes)
                    {
                        @if (ActiveContentTab == "release-notes")
                    {
                    <div role="tabpanel" id="@(versionPickerId + "-release-notes-panel")" aria-labelledby="@(versionPickerId + "-release-notes-tab")" tabindex="0">
                            <section class="pkg-readme overflow-x-auto rounded-lg border border-border bg-surface p-4" aria-label="Release notes">
                                @((MarkupString)ReleaseNotesHtml)
                            </section>
                        </div>
                    }
                    }

                    @if (ActiveContentTab == "badges")
                    {
                    <div role="tabpanel" id="@(versionPickerId + "-badges-panel")" aria-labelledby="@(versionPickerId + "-badges-tab")" tabindex="0">
                        <section class="mt-8 space-y-4">
                            <div class="badge-previews">
                                <img src="@GetBadgeUrl()" alt="Preview badge for @DetailPackageId" />
                            </div>
                            <div class="badge-snippet">
                                <h4>Markdown</h4>
                                <pre><code>[![@EffectiveFeedDisplayName](@(GetBadgeUrl()))](@(GetBadgeUrl()))</code></pre>
                            </div>
                        </section>
                    </div>
                    }

                    @if (ActiveContentTab == "diff")
                    {
                    <div role="tabpanel" id="@(versionPickerId + "-diff-panel")" aria-labelledby="@(versionPickerId + "-diff-tab")" tabindex="0">
                        <PackageDiffPanel PackageId="@DetailPackageId"
                                          CurrentVersion="@SelectedVersionString"
                                          Result="@DiffResult"
                                          OtherVersions="@OtherVersionStrings" />
                    </div>
                    }

                    @if (ActiveContentTab == "versions")
                    {
                    <div role="tabpanel" id="@(versionPickerId + "-versions-panel")" aria-labelledby="@(versionPickerId + "-versions-tab")" tabindex="0">
                        <table class="mt-2 w-full border-collapse text-sm">
                            <thead>
                                <tr>
                                    <th class="border-b-2 border-border bg-surface px-2 py-2 text-left font-semibold text-fg">Version</th>
                                    <th class="border-b-2 border-border bg-surface px-2 py-2 text-left font-semibold text-fg">Published</th>
                                    <th class="border-b-2 border-border bg-surface px-2 py-2 text-left font-semibold text-fg">Downloads</th>
                                    <th class="border-b-2 border-border bg-surface px-2 py-2 text-left font-semibold text-fg">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var info in packageVersions)
                                {
                                    var versionValue = info.Version?.OriginalVersion ?? string.Empty;
                                    <tr>
                                        <td class="border-b border-border px-2 py-2">
                                            <a class="font-semibold text-brand no-underline hover:underline"
                                               href="@PackageVersionUrl(versionValue)">@versionValue</a>
                                        </td>
                                        <td class="border-b border-border px-2 py-2 text-fg-secondary">@FormatAbsoluteDate(info.Published)</td>
                                        <td class="border-b border-border px-2 py-2">@info.Downloads.ToString("N0")</td>
                                        <td class="border-b border-border px-2 py-2 text-fg-secondary">
                                            @(info.IsListed ? "Listed" : "Unlisted")
                                            @(info.IsPrerelease ? " · Prerelease" : "")
                                            @(IsLiveUpstream(info) ? " · Available upstream" : "")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    }

                    @if (ActiveContentTab == "frameworks")
                    {
                    <div role="tabpanel" id="@(versionPickerId + "-frameworks-panel")" aria-labelledby="@(versionPickerId + "-frameworks-tab")" tabindex="0">
                        @if (FrameworkAssetList.Count > 0)
                        {
                            <ul class="mt-2 flex list-none flex-wrap gap-2 p-0">
                                @foreach (var folder in FrameworkAssetList)
                                {
                                    <li class="rounded border border-border bg-surface px-2 py-0.5 font-mono text-xs">@folder</li>
                                }
                            </ul>
                        }
                        else if (SelectedFrameworks.Count > 0)
                        {
                            <ul class="mt-2 flex list-none flex-wrap gap-2 p-0">
                                @foreach (var tfm in SelectedFrameworks)
                                {
                                    <li class="rounded border border-border bg-surface px-2 py-0.5 font-mono text-xs">@tfm</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-fg-secondary">No target frameworks indexed for this version.</p>
                        }
                    </div>
                    }
                </section>
                <aside class="flex w-full max-w-xs flex-col gap-4 max-md:max-w-none" aria-label="Package quick facts">
                    <section class="rounded-2xl border border-border bg-surface p-5 shadow-sm" aria-label="Package origin">
                        <h3>Origin</h3>
                        <div class="mt-2 flex items-center justify-between gap-3">
                            <span class="rounded-full border border-border bg-panel px-2.5 py-1 text-xs font-semibold text-fg">@OriginLabel</span>
                            @if (!string.IsNullOrWhiteSpace(SelectedPackageVersion?.PackageSourceName))
                            {
                                <span class="truncate text-sm font-medium text-fg" title="@SelectedPackageVersion.PackageSourceName">@SelectedPackageVersion.PackageSourceName</span>
                            }
                        </div>
                        <p class="mt-3 mb-0 text-sm leading-relaxed text-fg-secondary">@OriginDescription</p>
                        @if (SelectedPackageVersion?.MetadataFetchedAt is { } metadataFetchedAt)
                        {
                            <p class="mt-2 mb-0 text-xs text-fg-secondary" title="@FormatAbsoluteTimestamp(metadataFetchedAt)">
                                Metadata checked live @FormatHumanizedDate(metadataFetchedAt)
                            </p>
                        }
                        else if (SelectedPackageVersion?.PackageSourceLastSyncSuccessAt is { } lastSourceSuccess)
                        {
                            <p class="mt-2 mb-0 text-xs text-fg-secondary" title="@FormatAbsoluteTimestamp(lastSourceSuccess)">
                                Upstream last reached @FormatHumanizedDate(lastSourceSuccess)
                            </p>
                        }
                    </section>
                    <section class="rounded-2xl border border-brand/35 bg-gradient-to-br from-brand/15 to-brand/5 p-5 shadow-sm">
                        <h3>Package Stats</h3>
                        @if (IsSelectedLiveUpstream)
                        {
                            <p class="mt-2 mb-0 text-sm leading-relaxed text-fg-secondary">Download counts are unavailable in the upstream registration metadata used for this preview.</p>
                        }
                        else
                        {
                            <dl class="m-0 flex flex-col gap-2">
                                <div class="flex items-baseline justify-between border-b border-border px-1 py-1.5 last:border-b-0">
                                    <dt>Total</dt>
                                    <dd>@Package.TotalDownloads.ToString("N0")</dd>
                                </div>
                                <div class="flex items-baseline justify-between border-b border-border px-1 py-1.5 last:border-b-0">
                                    <dt>Current version</dt>
                                    <dd>@SelectedVersionDownloadCount.ToString("N0")</dd>
                                </div>
                                <div class="flex items-baseline justify-between border-b border-border px-1 py-1.5 last:border-b-0">
                                    <dt>Per day</dt>
                                    <dd>@Package.DownloadsPerDay.ToString("N0")</dd>
                                </div>
                            </dl>
                        }

                    </section>
                    <section class="rounded-2xl border border-border bg-gradient-to-br from-slate-400/10 to-slate-400/5 p-5 shadow-sm">
                        <h3>Downloads</h3>
                        @if (AllowPackageDownloads)
                        {
                            <div class="mt-2 flex flex-col gap-2" role="group" aria-label="Package downloads">
                                <a class="inline-flex items-center justify-center rounded-lg bg-brand px-3 py-2 text-sm font-semibold text-brand-on no-underline @(PackageDownloadUrl is null ? "pointer-events-none opacity-35" : "")"
                                   href="@PackageDownloadUrl" target="_blank" rel="noopener">
                                    Download package
                                </a>
                            </div>
                        }
                        else
                        {
                            <p class="mt-2 text-sm text-fg-secondary">Downloads are disabled for this feed.</p>
                        }

                        <ul class="m-0 flex list-none flex-col gap-2 p-0">
                            <li>
                                <span>Release type</span>
                                <span>@(SelectedPackageVersion?.IsPrerelease == true ? "Prerelease" : "Stable")</span>
                            </li>
                            <li>
                                <span>@(SelectedPackageVersion?.IsListed == true ? "Listed" : "Unlisted")</span>
                            </li>
                            <li>
                                <span>License acceptance</span>
                                <span>@(Package.RequireLicenseAcceptance ? "Required" : "Not required")</span>
                            </li>
                        </ul>
                    </section>
                </aside>
            </div>
        </article>
    }
</div>

<dialog @ref="licenseDialog" class="nuget-theme-scope package-license-dialog" aria-labelledby="@licenseTitleId">
    <div class="package-license-heading">
        <h2 id="@licenseTitleId">@DetailPackageId @SelectedVersionString — License</h2>
        <form method="dialog"><button type="submit" class="package-action" autofocus>Close</button></form>
    </div>
    @if (isLicenseLoading)
    {
        <p role="status">Loading license…</p>
    }
    else
    {
        <pre class="package-license-text">@(licenseText ?? "License contents are not available in this feed.")</pre>
    }
</dialog>

@code {
    [Parameter, EditorRequired]
    public PackageInfoCollection Package { get; set; } = default!;

    [Parameter]
    public string ProjectUrlTitle { get; set; } = "Project Site";

    [Parameter]
    public string? FeedBaseUrl { get; set; }

    [Parameter]
    public string? FeedDisplayName { get; set; }

    /// <summary>The route-selected version, including unlisted versions and normalized aliases.</summary>
    [Parameter]
    public string? RequestedVersion { get; set; }

    [Parameter]
    public string? ReadmeMarkdown { get; set; }

    [Parameter]
    public string? Compare { get; set; }

    [Parameter]
    public string? Tab { get; set; }

    [Parameter]
    public string? Install { get; set; }

    [Parameter]
    public string? SelectedFile { get; set; }

    [Parameter]
    public string? DiffView { get; set; }

    [Parameter]
    public string? Tfm { get; set; }

    [Parameter]
    public bool AllowPackageDownloads { get; set; } = true;

    [Parameter]
    public EventCallback<NuGetVersion> OnVersionSelected { get; set; }

    [Parameter]
    public string DefaultIconPath { get; set; } = "_content/AvantiPoint.Packages.UI.Razor/img/default-package-icon-256x256.png";

    [Parameter]
    public Func<string, Task<string?>>? GetLocalPackageUrl { get; set; }

    private string SelectedVersionString { get; set; } = string.Empty;
    private string ActiveInstallTab { get; set; } = "cli";
    private string ActiveContentTab { get; set; } = "readme";
    private PackageDiffResult? DiffResult { get; set; }
    private string? resolvedFeedDisplayName;

    private string ReadmeHtml { get; set; } = string.Empty;
    private static readonly MarkdownPipeline Pipeline = new MarkdownPipelineBuilder()
    .UseAdvancedExtensions()
    .DisableHtml()
    .Build();

    private PackageInfo? SelectedPackageVersion => packageVersions?.FirstOrDefault(v =>
        NuGetVersion.TryParse(SelectedVersionString, out var parsed) && v.Version == parsed)
        ?? packageVersions?.FirstOrDefault();

    private bool HasReleaseNotes => !string.IsNullOrWhiteSpace(SelectedPackageVersion?.ReleaseNotes);

    private string AlternatePackageHref => FeedUiPath.ToHref(
        NavigationManager,
        $"/packages/{Uri.EscapeDataString(SelectedPackageVersion?.DeprecatedAlternatePackageId ?? string.Empty)}");

    private string ReleaseNotesHtml => HasReleaseNotes
        ? Markdown.ToHtml(SelectedPackageVersion!.ReleaseNotes, Pipeline)
        : string.Empty;

    private IEnumerable<VersionGroup> VersionGroups => packageVersions?
    .GroupBy(v => v.Version?.Major ?? 0)
    .OrderByDescending(g => g.Key)
    .Select(g => new VersionGroup(g.Key, g.OrderByDescending(v => v.Version).ToList()))
    ?? Enumerable.Empty<VersionGroup>();

    private string PackageBaseUrl => FeedUiPath.ToHref(
        NavigationManager,
        $"/packages/{Uri.EscapeDataString(DetailPackageId)}");

    private string PackageVersionUrl(string version) =>
        $"{PackageBaseUrl}/{Uri.EscapeDataString(version)}";

    private string ContentBaseUrl => (string.IsNullOrWhiteSpace(FeedBaseUrl) ? NavigationManager.BaseUri :
    FeedBaseUrl).TrimEnd('/');

    private string IconSource => string.IsNullOrWhiteSpace(SelectedPackageVersion!.IconUrl) ? DefaultIconPath : SelectedPackageVersion!.IconUrl;

    private string BadgeBaseUrl => ContentBaseUrl;

    private string EffectiveFeedDisplayName => !string.IsNullOrWhiteSpace(FeedDisplayName)
    ? FeedDisplayName!
    : resolvedFeedDisplayName ??= ResolveFeedDisplayName();

    private long SelectedVersionDownloadCount => SelectedPackageVersion?.Downloads ?? 0;

    private bool IsSelectedLiveUpstream => IsLiveUpstream(SelectedPackageVersion);

    private string OriginLabel => SelectedPackageVersion?.Origin?.Trim() switch
    {
        var origin when string.Equals(origin, "Upstream", StringComparison.OrdinalIgnoreCase) => "Available upstream",
        var origin when string.Equals(origin, "Mirrored", StringComparison.OrdinalIgnoreCase) => "Mirrored",
        var origin when string.Equals(origin, "Cached", StringComparison.OrdinalIgnoreCase) => "Cached on demand",
        var origin when string.Equals(origin, "Published", StringComparison.OrdinalIgnoreCase) => "Published here",
        { Length: > 0 } origin => origin,
        _ => "Published here"
    };

    private string OriginDescription => SelectedPackageVersion?.Origin?.Trim() switch
    {
        var origin when string.Equals(origin, "Upstream", StringComparison.OrdinalIgnoreCase) =>
            LiveUpstreamOriginDescription,
        var origin when string.Equals(origin, "Mirrored", StringComparison.OrdinalIgnoreCase) =>
            "Copied from an upstream source and listed in this feed.",
        var origin when string.Equals(origin, "Cached", StringComparison.OrdinalIgnoreCase) =>
            "Stored after a client requested it; the upstream catalog was not copied.",
        var origin when string.Equals(origin, "Published", StringComparison.OrdinalIgnoreCase) =>
            "Published directly to this feed.",
        _ => "Stored in this feed."
    };

    private string LiveUpstreamOriginDescription => SelectedPackageVersion?.UpstreamCachingStrategy?.Trim() switch
    {
        var strategy when string.Equals(strategy, "ProxyOnly", StringComparison.OrdinalIgnoreCase) =>
            "Metadata was checked live by exact package ID; the upstream catalog was not copied. Downloads pass through this feed and are not retained.",
        var strategy when string.Equals(strategy, "CacheOnly", StringComparison.OrdinalIgnoreCase) =>
            "Metadata was checked live by exact package ID; the upstream catalog was not copied. A requested package is cached for restores without being added to the local catalog.",
        var strategy when string.Equals(strategy, "IndexAndCache", StringComparison.OrdinalIgnoreCase) =>
            "Metadata was checked live by exact package ID; the upstream catalog was not copied. The requested version is stored and added to local discovery only after it is downloaded.",
        _ => "Metadata was checked live by exact package ID; the upstream catalog and package content were not copied."
    };

    private static bool IsLiveUpstream(PackageInfo? package) =>
        string.Equals(package?.Origin?.Trim(), "Upstream", StringComparison.OrdinalIgnoreCase);

    private IReadOnlyList<string> SelectedFrameworks =>
        SelectedPackageVersion?.TargetFrameworks?
            .Where(static x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(static x => x, StringComparer.OrdinalIgnoreCase)
            .ToList()
        ?? (IReadOnlyList<string>)Array.Empty<string>();

    private IReadOnlyList<string> OtherVersionStrings =>
        packageVersions?
            .Select(v => v.Version?.OriginalVersion)
            .Where(v => !string.IsNullOrWhiteSpace(v) && !string.Equals(v, SelectedVersionString, StringComparison.OrdinalIgnoreCase))
            .Cast<string>()
            .ToList()
        ?? (IReadOnlyList<string>)Array.Empty<string>();

    private IReadOnlyList<string> FrameworkAssetList => DiffResult?.CurrentAssetFolders ?? Array.Empty<string>();

    private string? DefaultCompareVersion
    {
        get
        {
            var versions = packageVersions?
                .Where(v => v.Version is not null)
                .Select(v => v.Version!)
                .OrderByDescending(v => v)
                .ToList();
            if (versions is null || versions.Count == 0)
            {
                return null;
            }

            if (!NuGetVersion.TryParse(SelectedVersionString, out var current))
            {
                return versions.Select(v => v.OriginalVersion).FirstOrDefault(v =>
                    !string.Equals(v, SelectedVersionString, StringComparison.OrdinalIgnoreCase));
            }

            return (versions.FirstOrDefault(v => v < current)
                    ?? versions.FirstOrDefault(v => v != current))
                ?.OriginalVersion;
        }
    }

    private string? PackageDownloadUrl => BuildPackageDownloadUrl();

    private (string Text, string? Url) LicenseDisplay => GetLicenseDisplay();

    private string ToolCommand => $"dotnet tool install --global {DetailPackageId} --version {SelectedVersionString}";

    private string TemplateCommand => $"dotnet new install {DetailPackageId}::{SelectedVersionString}";

    private string CliCommand => $"dotnet add package {DetailPackageId} --version {SelectedVersionString}";

    private string PackageManagerCommand => $"NuGet\\Install-Package {DetailPackageId} -Version {SelectedVersionString}";

    private string PackageReferenceCommand => $"<PackageReference Include=\"{DetailPackageId}\" Version=\"{SelectedVersionString}\" />";

    private string CpmDirectoryPackagesPropsCommand => $"<PackageVersion Include=\"{DetailPackageId}\" Version=\"{SelectedVersionString}\" />";
    private string CpmCsprojCommand => $"<PackageReference Include=\"{DetailPackageId}\" />";

    private IEnumerable<InstallTab> InstallTabs => new[]
    {
new InstallTab("cli", ".NET CLI", CliCommand, false, "terminal"),
new InstallTab("pmc", "Package Manager", PackageManagerCommand, false, "terminal"),
new InstallTab("packageref", "PackageReference", PackageReferenceCommand, true, "xml"),
new InstallTab("cpm", "Central Package Management", string.Empty, true, "xml")
};

    private static string FormatHumanizedDate(DateTimeOffset? date)
    {
        if (date is null)
        {
            return "Unknown";
        }

        return date.Value.UtcDateTime.Humanize(
            dateToCompareAgainst: DateTime.UtcNow,
            culture: CultureInfo.InvariantCulture);
    }

    private static string FormatAbsoluteDate(DateTimeOffset? date)
    {
        return date?.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture) ?? "Unknown date";
    }

    private static string FormatAbsoluteTimestamp(DateTimeOffset date) =>
        date.ToString("MMMM d, yyyy 'at' HH:mm 'UTC'", CultureInfo.InvariantCulture);

    private string ResolveFeedDisplayName()
    {
        var configured = Configuration["Shield:ServerName"];
        return string.IsNullOrWhiteSpace(configured)
        ? "AvantiPoint Package Server"
        : configured;
    }

    private (string Text, string? Url) GetLicenseDisplay() =>
        PackageLicenseDisplay.Describe(SelectedPackageVersion!.LicenseExpression, SelectedPackageVersion!.HasEmbeddedLicense, SelectedPackageVersion!.LicenseUrl);

    private static string? SafeWebUrl(string? value) =>
        Uri.TryCreate(value, UriKind.Absolute, out var uri)
        && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps)
            ? uri.ToString()
            : null;

    private string? BuildPackageDownloadUrl()
    {
        if (!AllowPackageDownloads || Package is null || SelectedPackageVersion?.Version is null)
        {
            return null;
        }

        var id = DetailPackageId;
        if (string.IsNullOrWhiteSpace(id))
        {
            return null;
        }

        var normalizedId = id.ToLowerInvariant();
        var normalizedVersion = SelectedPackageVersion.Version.ToNormalizedString().ToLowerInvariant();

        return $"{ContentBaseUrl}/v3/package/{normalizedId}/{normalizedVersion}/{normalizedId}.{normalizedVersion}.nupkg";
    }

    private async Task CopyCommandAsync(string command)
    {
        if (string.IsNullOrWhiteSpace(command))
        {
            return;
        }

        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", command);
    }

    private void SetInstallTab(string tabId)
    {
        ActiveInstallTab = tabId;
    }

    private string ContentTabUrl(string tabId)
    {
        var parts = new List<string> { $"tab={Uri.EscapeDataString(tabId)}" };
        if (!string.IsNullOrWhiteSpace(ActiveInstallTab) && ActiveInstallTab != "cli")
            parts.Add($"install={Uri.EscapeDataString(ActiveInstallTab)}");
        var compare = Compare;
        if (string.IsNullOrWhiteSpace(compare) && string.Equals(tabId, "diff", StringComparison.OrdinalIgnoreCase))
        {
            compare = DefaultCompareVersion;
        }
        if (!string.IsNullOrWhiteSpace(compare) && string.Equals(tabId, "diff", StringComparison.OrdinalIgnoreCase))
        {
            parts.Add($"compare={Uri.EscapeDataString(compare)}");
        }
        if (!string.IsNullOrWhiteSpace(SelectedFile) && string.Equals(tabId, "diff", StringComparison.OrdinalIgnoreCase))
        {
            parts.Add($"file={Uri.EscapeDataString(SelectedFile)}");
        }
        if (!string.IsNullOrWhiteSpace(DiffView) && string.Equals(tabId, "diff", StringComparison.OrdinalIgnoreCase))
        {
            parts.Add($"view={Uri.EscapeDataString(DiffView)}");
        }
        if (!string.IsNullOrWhiteSpace(Tfm) && string.Equals(tabId, "diff", StringComparison.OrdinalIgnoreCase))
        {
            parts.Add($"tfm={Uri.EscapeDataString(Tfm)}");
        }
        return $"{PackageBaseUrl}/{Uri.EscapeDataString(SelectedVersionString)}?{string.Join("&", parts)}";
    }

    private string InstallTabUrl(string installId)
    {
        var parts = new List<string> { $"install={Uri.EscapeDataString(installId)}" };
        if (!string.IsNullOrWhiteSpace(ActiveContentTab) && ActiveContentTab != "readme")
        {
            parts.Add($"tab={Uri.EscapeDataString(ActiveContentTab)}");
        }
        if (!string.IsNullOrWhiteSpace(Compare) && ActiveContentTab == "diff")
        {
            parts.Add($"compare={Uri.EscapeDataString(Compare)}");
        }
        return $"{PackageBaseUrl}/{Uri.EscapeDataString(SelectedVersionString)}?{string.Join("&", parts)}";
    }

    private string GetBadgeUrl() => $"{BadgeBaseUrl}/shield/{Uri.EscapeDataString(DetailPackageId)}/vpre";

    private sealed record InstallTab(string Id, string Label, string Command, bool IsMarkup, string StyleClass);

    private sealed record VersionGroup(int Major, IReadOnlyList<PackageInfo> Items);
}
