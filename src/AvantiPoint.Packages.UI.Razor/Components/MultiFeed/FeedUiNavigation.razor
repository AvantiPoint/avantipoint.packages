@using AvantiPoint.Feed.Platform
@inject IFeedRegistry FeedRegistry
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@inject IOptionsMonitor<OciFeedOptions> OciOptions

@RenderLink("/browse", "Explore", true)
@if (FeedRegistry.TryGetNuGetSurface() is not null)
{
    @RenderLink("/", IncludeBrowseLinks ? "NuGet" : "Search", !IsUnifiedBrowse && (IncludeBrowseLinks || IsKind("nuget")))
    @RenderLink("/feed", "Connect", !IsUnifiedBrowse && IsKind("nuget"))
}
@if (FeedRegistry.TryGetNpmSurface() is not null)
{
    @RenderLink("/browse/npm", IncludeBrowseLinks ? "npm" : "Search", !IsUnifiedBrowse && (IncludeBrowseLinks || IsKind("npm")))
    @RenderLink("/browse/npm/connect", "Connect", !IsUnifiedBrowse && IsKind("npm"))
}
@foreach (var oci in GetOciSurfaces())
{
    var href = GetOciCatalogHref(oci);
    var label = IncludeBrowseLinks ? GetOciNavLabel(oci) : "Search";
    @RenderLink(href, label, !IsUnifiedBrowse && (IncludeBrowseLinks || IsActiveOciSurface(oci)))
}

@if (!IsUnifiedBrowse && IsKind("oci"))
{
    @RenderLink(FeedProtocolPreference.ConnectHref(ActiveProtocol()), "Connect", true)
}

@code {
    [Parameter]
    public bool RenderAsListItems { get; set; }

    [Parameter]
    public bool IncludeBrowseLinks { get; set; } = true;
    private const string NavLinkClass =
        "text-header-fg no-underline opacity-90 hover:text-header-fg hover:underline hover:opacity-100";

    private bool IsUnifiedBrowse => FeedUiPath.CurrentApplicationPath(Navigation)
        .Equals("/browse", StringComparison.OrdinalIgnoreCase);


    private IEnumerable<SurfaceRegistration> GetOciSurfaces() =>
        FeedRegistry.Surfaces.Where(s => s.Protocol == FeedProtocol.Oci);

    private string GetOciNavLabel(SurfaceRegistration surface) =>
        OciSurfacePresentation.GetDisplayName(
            OciOptions.Get(GetOciOptionsName(surface)),
            surface.OciSegment);

    private static string GetOciOptionsName(SurfaceRegistration surface) =>
        string.IsNullOrEmpty(surface.OciSegment)
            ? "OciFeed:default"
            : OciSurfaceOptionsBuilder.GetOptionsName(surface.OciSegment);

    private static string GetOciCatalogHref(SurfaceRegistration surface) =>
        string.IsNullOrEmpty(surface.OciSegment) ? "/oci" : $"/oci/{surface.OciSegment}";

    private string ActiveProtocol()
    {
        var path = FeedUiPath.CurrentApplicationPath(Navigation);
        var cookie = HttpContextAccessor.HttpContext?.Request.Cookies[FeedProtocolPreference.CookieName];
        return FeedProtocolPreference.Resolve(path, cookie);
    }

    private bool IsKind(string kind) =>
        string.Equals(FeedProtocolPreference.GetKind(ActiveProtocol()), kind, StringComparison.OrdinalIgnoreCase);

    private bool IsActiveOciSurface(SurfaceRegistration surface)
    {
        var protocol = ActiveProtocol();
        if (!string.Equals(FeedProtocolPreference.GetKind(protocol), "oci", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        var activeSegment = FeedProtocolPreference.GetOciSegment(protocol);
        return string.Equals(activeSegment, surface.OciSegment, StringComparison.OrdinalIgnoreCase);
    }

    private RenderFragment RenderLink(string href, string label, bool visible) => builder =>
    {
        if (!visible)
        {
            return;
        }

        if (RenderAsListItems)
        {
            builder.OpenElement(0, "li");
            builder.OpenElement(1, "a");
            builder.AddAttribute(2, "class", NavLinkClass);
            builder.AddAttribute(3, "href", FeedUiPath.ToHref(Navigation, href));
            builder.AddContent(4, label);
            builder.CloseElement();
            builder.CloseElement();
            return;
        }

        builder.OpenElement(0, "a");
        builder.AddAttribute(1, "class", NavLinkClass);
        builder.AddAttribute(2, "href", FeedUiPath.ToHref(Navigation, href));
        builder.AddContent(3, label);
        builder.CloseElement();
    };
}
