@using AvantiPoint.Feed.Platform
@using AvantiPoint.Feed.Platform.Configuration
@inject IHttpContextAccessor HttpContextAccessor
@inject IPublicBaseUrlProvider PublicBaseUrlProvider
@inject IFeedRegistry FeedRegistry
@inject IOptionsMonitor<FeedOptions> FeedOptions

@if (FeedRegistry.TryGetNpmSurface() is null)
{
    <p role="status">npm surface is not registered on this host.</p>
}
else
{
    <div class="mb-6 rounded-md border border-border bg-panel p-6">
        <h3>npm registry connection</h3>

        @if (!ShowAuthenticationInfo)
        {
        <div class="mb-6 last:mb-0">
            <h4>Configure npm</h4>
            <CopyableSnippet Label="CLI"
                             Value="@NpmConfigCommand"
                             CopyLabel="Copy npm registry command"
                             CssClass="mb-3" />
            <CopyableSnippet Label=".npmrc"
                             Value="@NpmRcRegistryLine"
                             CopyLabel="Copy .npmrc registry setting" />
        </div>
        }

        @if (ShowAuthenticationInfo)
        {
            <p>Create an API key with npm read access. Your website password and the upstream provider's token are not credentials for this registry.</p>
            <CopyableSnippet Label="Configure npm and install"
                             Value="@InstallCommand"
                             CopyLabel="Copy authenticated npm install command" />
            <p class="text-sm text-muted">Replace <code>&lt;API_KEY&gt;</code> with your key. These commands save it in your user npm configuration. Keep that file private; your shell may record the commands.</p>
            <details class="mt-4">
                <summary>Configure .npmrc instead</summary>
                <CopyableSnippet Label=".npmrc"
                                 Value="@(NpmRcRegistryLine + "\n" + NpmAuthTokenLine.Replace("${NPM_TOKEN}", "<API_KEY>"))"
                                 CopyLabel="Copy authenticated .npmrc configuration" />
                <p>Do not commit a configuration file containing your API key.</p>
            </details>
        }
    </div>
}

@code {
    [Parameter]
    public bool ShowAuthenticationInfo { get; set; }

    private string RegistryUrl { get; set; } = string.Empty;

    private string NpmConfigCommand => $"npm config set registry {RegistryUrl}";

    private string NpmRcRegistryLine => $"registry={RegistryUrl}";

    private string NpmAuthTokenLine => NpmRegistryInstructions.BuildAuthTokenLine(RegistryUrl);

    private string InstallCommand => $"npm config set registry \"{RegistryUrl}\" --location=user\nnpm config set \"{NpmAuthTokenLine.Split('=')[0]}\" \"<API_KEY>\" --location=user\nnpm install";

    protected override void OnParametersSet()
    {
        var npmSurface = FeedRegistry.TryGetNpmSurface();
        if (npmSurface is null)
        {
            return;
        }

        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext is null)
        {
            RegistryUrl = $"{npmSurface.RoutePrefix}/";
            return;
        }

        var baseUrl = PublicBaseUrlProvider.GetSurfacePublicBaseUrl(httpContext, npmSurface.RoutePrefix);
        RegistryUrl = baseUrl.ToString().TrimEnd('/') + "/";
        ShowAuthenticationInfo = ShowAuthenticationInfo
            || !FeedOptions.CurrentValue.Authentication.AllowAnonymousPull
            || !string.IsNullOrEmpty(FeedOptions.CurrentValue.Authentication.ApiKey);
    }

}
