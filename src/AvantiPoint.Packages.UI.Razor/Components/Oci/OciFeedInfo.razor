@using AvantiPoint.Feed.Platform
@using AvantiPoint.Feed.Platform.Configuration
@using AvantiPoint.Packages.UI.Services
@inject IFeedRegistry FeedRegistry
@inject IOciRepositoryBrowseService BrowseService
@inject IOptionsMonitor<FeedOptions> FeedOptions
@inject IOptionsMonitor<OciFeedOptions> OciOptions
@inject IHttpContextAccessor HttpContextAccessor
@using System.Security.Claims

@if (ResolveSurface() is null)
{
    <p role="status">OCI surface is not registered on this host.</p>
}
else
{
    <div class="mb-6 rounded-md border border-border bg-panel p-6">
        <h2>@ConnectionTitle</h2>

        <p>Replace <code>&lt;API_KEY&gt;</code> with your API key. Use your email as the username, not your display name.</p>
        <p class="text-sm text-muted">Your shell may record the command. To enter the key privately, omit <code>--password</code> and its value and use the client's password prompt.</p>

        <details class="mb-6"><summary>Registry API endpoint</summary>
        <CopyableSnippet Label="Registry API"
                         Value="@RegistryApiUrl"
                         CopyLabel="Copy registry API URL"
                         CssClass="mb-6" />
        </details>

        @if (Profile is OciProfile.General or OciProfile.ContainerImages)
        {
            <div class="mb-6 last:mb-0">
                <h4>Docker</h4>
                <CopyableSnippet Label="Login"
                                 Value="@GetLoginCommand("docker login")"
                                 CopyLabel="Copy Docker login command"
                                 CssClass="mb-3" />
                <CopyableSnippet Label="Pull image"
                                 Value="@GetDockerPullCommand()"
                                 CopyLabel="Copy Docker pull command" />
            </div>
        }

        @if (Profile is OciProfile.General or OciProfile.HelmCharts)
        {
            <div class="mb-6 last:mb-0">
                <h4>Helm OCI</h4>
                <CopyableSnippet Label="Login"
                                 Value="@GetLoginCommand("helm registry login")"
                                 CopyLabel="Copy Helm registry login command"
                                 CssClass="mb-3" />
                <CopyableSnippet Label="Pull chart"
                                 Value="@GetHelmPullCommand()"
                                 CopyLabel="Copy Helm pull command" />
            </div>
        }

        <details class="mb-6 last:mb-0" open="@(Profile == OciProfile.General)">
            <summary>Use ORAS for generic OCI artifacts</summary>
            <h4>ORAS</h4>
            <CopyableSnippet Label="Login"
                             Value="@GetLoginCommand("oras login")"
                             CopyLabel="Copy ORAS login command"
                             CssClass="mb-3" />
            <CopyableSnippet Label="Pull artifact"
                             Value="@GetOrasPullCommand()"
                             CopyLabel="Copy ORAS pull command" />
        </details>

    </div>
}

@code {
    [Parameter]
    public string? Segment { get; set; }

    [Parameter]
    public bool ShowAuthenticationInfo { get; set; }

    private string RegistryApiUrl { get; set; } = string.Empty;

    private OciProfile Profile => OciOptions.Get(GetOptionsName()).Profile;

    private string ConnectionTitle => Profile switch
    {
        OciProfile.ContainerImages => "Docker registry connection",
        OciProfile.HelmCharts => "Helm OCI registry connection",
        _ => "OCI registry connection",
    };

    protected override void OnParametersSet()
    {
        if (ResolveSurface() is null)
        {
            return;
        }

        RegistryApiUrl = BrowseService.GetRegistryApiUrl(Segment);
        ShowAuthenticationInfo = ShowAuthenticationInfo
            || !FeedOptions.CurrentValue.Authentication.AllowAnonymousPull
            || !string.IsNullOrEmpty(FeedOptions.CurrentValue.Authentication.ApiKey);
    }

    private SurfaceRegistration? ResolveSurface() =>
        string.IsNullOrEmpty(Segment)
            ? FeedRegistry.TryGetDefaultOciSurface()
            : FeedRegistry.TryGetOciSurfaceBySegment(Segment);

    private string? ResolvedEmail =>
        HttpContextAccessor.HttpContext?.User?.FindFirst(ClaimTypes.Email)?.Value;

    private string GetLoginCommand(string command)
    {
        var host = GetLoginHost();
        var email = ResolvedEmail;
        var username = string.IsNullOrWhiteSpace(email) ? "<email>" : email;
        return $"{command} {host} --username \"{username}\" --password \"<API_KEY>\""
            + (UsePlainHttp && command is "helm registry login" or "oras login" ? " --plain-http" : string.Empty);
    }

    private string GetDockerPullCommand() =>
        $"docker pull {GetPullHost()}/{{repository}}:{{tag}}";

    private string GetHelmPullCommand() =>
        OciCommandBuilder.BuildHelmPull(GetPullHost(), "{repository}", "{version}", UsePlainHttp);

    private string GetOrasPullCommand() =>
        OciCommandBuilder.BuildOrasPull(GetPullHost(), "{repository}", "{tag}", UsePlainHttp);

    private bool UsePlainHttp => Uri.TryCreate(RegistryApiUrl, UriKind.Absolute, out var uri)
        && uri.Scheme == Uri.UriSchemeHttp;

    private string GetOptionsName() => string.IsNullOrEmpty(Segment)
        ? "OciFeed:default"
        : OciSurfaceOptionsBuilder.GetOptionsName(Segment);

    private string GetLoginHost() =>
        string.IsNullOrEmpty(RegistryApiUrl)
            ? "localhost"
            : RegistryCommandHost.GetLoginHost(RegistryApiUrl);

    private string GetPullHost() =>
        string.IsNullOrEmpty(RegistryApiUrl)
            ? "localhost"
            : RegistryCommandHost.GetPullHost(RegistryApiUrl, Segment);
}
