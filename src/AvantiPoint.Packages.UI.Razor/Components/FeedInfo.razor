@inject IHttpContextAccessor HttpContextAccessor
@inject IPublicBaseUrlProvider PublicBaseUrlProvider
@inject IFeedRegistry FeedRegistry
@inject IOptionsMonitor<AvantiPoint.Feed.Platform.Configuration.FeedOptions> FeedOptions
@using AvantiPoint.Feed.Platform
@using System.Security.Claims

<div class="mb-6 rounded-md border border-border bg-panel p-6">
    <h3>Connect to NuGet</h3>

    @if (RequiresAuthentication)
    {
        <p>Create an API key with NuGet read access. Use your email as the username and the key as the password—not your website password.</p>
        <CopyableSnippet Label="Add NuGet source"
                         Value="@NuGetCommandBuilder.BuildAddSource(GetFeedUrl(), FeedName, ResolvedUsername, "\"<API_KEY>\"")"
                         CopyLabel="Copy authenticated .NET CLI source command" />
        <p class="text-sm text-muted">Replace <code>&lt;API_KEY&gt;</code> with your key. This saves it in your user NuGet configuration in clear text. Keep that file private and be aware that your shell may record the command.</p>
        <details class="mt-4">
            <summary>Feed URL for IDE setup</summary>
            <CopyableSnippet Label="NuGet Feed URL" Value="@GetFeedUrl()" CopyLabel="Copy NuGet feed URL" />
            <p>In your IDE, add this source with your email and API key.</p>
        </details>
    }
    else
    {

    <CopyableSnippet Label="NuGet Feed URL"
                     Value="@GetFeedUrl()"
                     CopyLabel="Copy NuGet feed URL"
                     CssClass="mb-6" />

    <div class="mb-6 last:mb-0">
        <h4>Add to NuGet Sources</h4>
        <CopyableSnippet Label=".NET CLI"
                         Value="@GetDotNetCli()"
                         CopyLabel="Copy .NET CLI source command"
                         CssClass="mb-3" />
        <CopyableSnippet Label="NuGet CLI"
                         Value="@GetNuGetCli()"
                         CopyLabel="Copy NuGet CLI source command" />
    </div>

    <div class="mb-6 last:mb-0">
        <h4>Use in NuGet.Config</h4>
        <CopyableSnippet Label="NuGet.Config"
                         Value="@GetNuGetConfig()"
                         CopyLabel="Copy NuGet.Config snippet"
                         IsXml="true" />
    </div>

    }
</div>

@code {
    /// <summary>
    /// The display name for the feed (used in configuration examples).
    /// </summary>
    [Parameter]
    public string FeedName { get; set; } = "MyNuGetFeed";

    /// <summary>
    /// Whether to show authentication information.
    /// </summary>
    [Parameter]
    public bool ShowAuthenticationInfo { get; set; } = false;

    [Parameter]
    public string? Username { get; set; }

    private bool RequiresAuthentication => ShowAuthenticationInfo
        || !FeedOptions.CurrentValue.Authentication.AllowAnonymousPull
        || !string.IsNullOrEmpty(FeedOptions.CurrentValue.Authentication.ApiKey);

    private string? ResolvedUsername =>
        !string.IsNullOrWhiteSpace(Username)
            ? Username
            : HttpContextAccessor.HttpContext?.User?.FindFirst(ClaimTypes.Email)?.Value;

    private string GetFeedUrl()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext is null)
        {
            return "/v3/index.json";
        }

        var routePrefix = FeedRegistry.TryGetNuGetSurface()?.RoutePrefix ?? string.Empty;
        var baseUrl = PublicBaseUrlProvider
            .GetSurfacePublicBaseUrl(httpContext, routePrefix)
            .ToString()
            .TrimEnd('/');
        return $"{baseUrl}/v3/index.json";
    }

    private string GetDotNetCli() =>
        $"dotnet nuget add source {GetFeedUrl()} --name \"{FeedName}\"";

    private string GetNuGetCli() =>
        $"nuget sources add -Name \"{FeedName}\" -Source {GetFeedUrl()}";

    private string GetNuGetConfig() => $"""
        <?xml version="1.0" encoding="utf-8"?>
        <configuration>
          <packageSources>
            <add key="{FeedName}" value="{GetFeedUrl()}" />
          </packageSources>
        </configuration>
        """;
}
