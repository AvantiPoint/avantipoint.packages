@namespace AvantiPoint.Packages.UI.Components
@using AvantiPoint.Packages.UI.Services
@using System.Net
@inject NavigationManager Navigation

<section class="space-y-6" aria-label="Package diff">
    @if (OtherVersions.Count > 0)
    {
        <div>
            <p class="mb-2 text-sm text-fg-secondary">Compare this version to</p>
            <div class="flex flex-wrap gap-2" aria-label="Compare versions">
                @foreach (var version in OtherVersions)
                {
                    var isActive = string.Equals(version, Result?.CompareVersion, StringComparison.OrdinalIgnoreCase);
                    <a class="rounded border px-2 py-0.5 text-xs font-medium no-underline @(isActive ? "border-brand bg-brand/15 text-fg" : "border-border bg-surface text-brand hover:bg-border")"
                       data-enhance-nav="false"
                       href="@Href(version, Result?.SelectedFile, Result?.View)">@Encode(version)</a>
                }
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Result?.Message) && Result!.Message.IndexOf("Public API", StringComparison.OrdinalIgnoreCase) < 0)
    {
        <p class="rounded-lg border border-dashed border-border bg-surface px-3 py-2 text-sm text-fg-secondary">@Result!.Message</p>
    }

    @if (!string.IsNullOrWhiteSpace(Result?.Error))
    {
        <p class="rounded-lg border border-border bg-surface px-3 py-2 text-sm text-fg" role="alert">@Result!.Error</p>
    }

    @if (Result is not null)
    {
        <div class="pkg-diff-explorer">
            <nav class="pkg-diff-tree" aria-label="Files">
                <h3 class="mb-2 text-base font-semibold">Files</h3>
                <ul class="m-0 list-none space-y-1 p-0 font-mono text-xs">
                    @foreach (var node in Result.Tree)
                    {
                        var nodeActive = string.Equals(node.Path, Result.SelectedFile, StringComparison.OrdinalIgnoreCase);
                        <li>
                            <a class="pkg-diff-tree-link @(nodeActive ? "is-active" : null) change-@node.Change"
                               data-enhance-nav="false"
                               href="@Href(Result.CompareVersion, node.Path, Result.View)">@Encode(node.Name)</a>
                            @if (node.Children.Count > 0)
                            {
                                <ul class="ml-3 mt-1 list-none space-y-0.5 p-0">
                                    @foreach (var child in node.Children)
                                    {
                                        var childActive = string.Equals(child.Path, Result.SelectedFile, StringComparison.OrdinalIgnoreCase);
                                        <li>
                                            <a class="pkg-diff-tree-link @(childActive ? "is-active" : null) change-@child.Change"
                                               data-enhance-nav="false"
                                               href="@Href(Result.CompareVersion, child.Path, Result.View)">@Encode(child.Name)</a>
                                        </li>
                                    }
                                </ul>
                            }
                        </li>
                    }
                </ul>
            </nav>
            <div class="pkg-diff-content">
                @if (string.IsNullOrWhiteSpace(Result.SelectedFile))
                {
                    <p class="text-sm text-fg-secondary">Select a file to view source.</p>
                }
                else
                {
                    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
                        <div>
                            <h3 class="mb-0 text-base font-semibold">@Encode(Result.SelectedFile)</h3>
                            <p class="mb-0 text-xs text-fg-secondary">
                                @SourceLabel(Result.TextSource)
                                @if (Result.HasCompareVersion)
                                {
                                    <text> · @Encode(Result.CompareVersion) → @Encode(Result.CurrentVersion)</text>
                                }
                            </p>
                        </div>
                        <div class="flex gap-2">
                            <a class="rounded border px-2 py-0.5 text-xs font-medium no-underline @(Result.View != "split" ? "border-brand bg-brand/15 text-fg" : "border-border text-brand")"
                               data-enhance-nav="false"
                               href="@Href(Result.CompareVersion, Result.SelectedFile, "unified")">Unified</a>
                            <a class="rounded border px-2 py-0.5 text-xs font-medium no-underline @(Result.View == "split" ? "border-brand bg-brand/15 text-fg" : "border-border text-brand")"
                               data-enhance-nav="false"
                               href="@Href(Result.CompareVersion, Result.SelectedFile, "split")">Side by side</a>
                        </div>
                    </div>
                    @if (!Result.HasCompareVersion)
                    {
                        <pre class="pkg-diff-pane" tabindex="0"><code>@(Result.RightText ?? string.Empty)</code></pre>
                    }
                    else if (Result.View == "split")
                    {
                        <div class="pkg-diff-split">
                            <div>
                                <p class="mb-1 text-xs font-semibold text-fg-secondary">@Encode(Result.CompareVersion)</p>
                                <pre class="pkg-diff-pane" tabindex="0"><code>@(Result.LeftText ?? string.Empty)</code></pre>
                            </div>
                            <div>
                                <p class="mb-1 text-xs font-semibold text-fg-secondary">@Encode(Result.CurrentVersion)</p>
                                <pre class="pkg-diff-pane" tabindex="0"><code>@(Result.RightText ?? string.Empty)</code></pre>
                            </div>
                        </div>
                    }
                    else if (Result.Lines.Count == 0)
                    {
                        @if (string.IsNullOrEmpty(Result.LeftText) && string.IsNullOrEmpty(Result.RightText))
                        {
                            <p class="text-sm text-fg-secondary">No source text for this file.</p>
                        }
                        else
                        {
                            <pre class="pkg-diff-pane" tabindex="0"><code>@(Result.RightText ?? Result.LeftText ?? string.Empty)</code></pre>
                        }
                    }
                    else
                    {
                        <div class="pkg-diff-unified" role="region" aria-label="Source text diff">
                            @foreach (var line in Result.Lines)
                            {
                                <div class="pkg-diff-line pkg-diff-line-@line.Kind">
                                    <span class="pkg-diff-gutter">@(line.LeftNumber?.ToString() ?? "")</span>
                                    <span class="pkg-diff-gutter">@(line.RightNumber?.ToString() ?? "")</span>
                                    <span class="pkg-diff-prefix">@(line.Kind == "add" ? "+" : line.Kind == "del" ? "-" : " ")</span>
                                    <span class="pkg-diff-text">@line.Text</span>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public string PackageId { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string CurrentVersion { get; set; } = string.Empty;

    [Parameter]
    public PackageDiffResult? Result { get; set; }

    [Parameter]
    public IReadOnlyList<string> OtherVersions { get; set; } = [];

    private string Href(string? compareVersion, string? filePath, string? view)
    {
        var parts = new List<string> { "tab=diff" };
        if (!string.IsNullOrWhiteSpace(compareVersion))
        {
            parts.Add($"compare={Uri.EscapeDataString(compareVersion)}");
        }
        if (!string.IsNullOrWhiteSpace(filePath))
        {
            parts.Add($"file={Uri.EscapeDataString(filePath)}");
        }
        if (string.Equals(view, "split", StringComparison.OrdinalIgnoreCase))
        {
            parts.Add("view=split");
        }
        return FeedUiPath.ToHref(
            Navigation,
            $"/packages/{Uri.EscapeDataString(PackageId)}/{Uri.EscapeDataString(CurrentVersion)}?{string.Join("&", parts)}");
    }

    private static MarkupString Encode(string? value)
        => (MarkupString)WebUtility.HtmlEncode(value ?? string.Empty);

    private static string SourceLabel(string? kind)
        => kind switch
        {
            "SourceLink" => "SourceLink original source",
            "Decompiled" => "Decompiled with ILSpy",
            "PackageFile" => "Package file text",
            "Missing" => "File missing in this version",
            _ => "Source"
        };
}
