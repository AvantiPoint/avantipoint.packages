@page "/"
@using AvantiPoint.Packages.UI.Components
@using AvantiPoint.Packages.UI.Components.MultiFeed
@{
    ViewData["Title"] = "Packages";
}

@(await Html.RenderComponentAsync<FeedBrowseHeader>(
    RenderMode.Static,
    new
    {
        Ecosystem = "NuGet",
        Title = "NuGet packages",
        Description = "Find .NET libraries, tools, and templates. Inspect dependencies, compare versions, and explore package source before installing.",
        ConnectHref = "/feed",
        ConnectLabel = "Connect NuGet"
    }))

@(await Html.RenderComponentAsync<PackageSearch>(
    RenderMode.ServerPrerendered,
    new
    {
        Placeholder = "Search packages in this feed..."
    }))

@section Scripts {
}
