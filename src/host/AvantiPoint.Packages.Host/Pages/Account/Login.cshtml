@page "/Account/Login"
@model AvantiPoint.Packages.Host.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
    var idpBtn = Model.ProviderKey switch
    {
        "microsoft" => "idp-btn border-[#8c8c8c] bg-white text-[#5e5e5e] hover:bg-[#f3f3f3]",
        "google" => "idp-btn border-[#dadce0] bg-white text-[#3c4043] hover:bg-[#f7f8f8]",
        "github" => "idp-btn border-[#24292f] bg-[#24292f] text-white hover:bg-[#1b1f23]",
        _ => "idp-btn border-border bg-surface text-fg hover:bg-page",
    };
}

<section class="flex min-h-[calc(100vh-8rem)] items-start justify-center px-0 py-8 pb-16 max-md:min-h-0 max-md:pt-4" aria-labelledby="signin-title">
    <div class="w-full max-w-md rounded-2xl border border-border bg-panel px-7 py-8 shadow-pkg max-md:px-[1.15rem] max-md:py-6">
        <p class="mb-1.5 text-xs font-bold uppercase tracking-[0.08em] text-muted">Package Feed</p>
        <h1 id="signin-title" class="mb-2">Sign in</h1>
        <p class="mb-5 text-fg-secondary">Use your organization account to access this package feed.</p>

        @if (Model.AuthConfigured)
        {
            <form method="post" class="m-0">
                <button type="submit" class="inline-flex min-h-11 w-full items-center justify-center gap-3 rounded-md border text-base font-semibold @idpBtn focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">
                    @if (Model.ProviderKey == "microsoft")
                    {
                        <svg class="size-[21px] shrink-0" viewBox="0 0 21 21" aria-hidden="true" focusable="false">
                            <rect x="1" y="1" width="9" height="9" fill="#f25022" />
                            <rect x="11" y="1" width="9" height="9" fill="#7fba00" />
                            <rect x="1" y="11" width="9" height="9" fill="#00a4ef" />
                            <rect x="11" y="11" width="9" height="9" fill="#ffb900" />
                        </svg>
                    }
                    else if (Model.ProviderKey == "google")
                    {
                        <svg class="size-[21px] shrink-0" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path fill="#4285F4" d="M23.52 12.27c0-.86-.07-1.49-.22-2.14H12v3.89h6.48c-.13 1.09-.84 2.73-2.42 3.83l-.02.14 3.52 2.67.24.02c2.24-2.07 3.72-5.12 3.72-8.41z" />
                            <path fill="#34A853" d="M12 24c3.24 0 5.96-1.07 7.95-2.91l-3.79-2.87c-1.01.7-2.37 1.19-4.16 1.19-3.18 0-5.88-2.09-6.84-4.99l-.14.01-3.71 2.82-.05.13C3.24 21.35 7.31 24 12 24z" />
                            <path fill="#FBBC05" d="M5.16 14.42A7.24 7.24 0 0 1 4.77 12c0-.84.15-1.66.38-2.42l-.01-.16-3.76-2.86-.12.06A11.96 11.96 0 0 0 0 12c0 1.94.47 3.77 1.26 5.38l3.9-2.96z" />
                            <path fill="#EA4335" d="M12 4.75c2.25 0 3.77.97 4.64 1.78l3.39-3.31C17.95 1.19 15.24 0 12 0 7.31 0 3.24 2.65 1.26 6.62l3.9 2.96C6.12 6.68 8.82 4.75 12 4.75z" />
                        </svg>
                    }
                    else if (Model.ProviderKey == "github")
                    {
                        <svg class="size-[21px] shrink-0" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path fill="currentColor" d="M12 .3a12 12 0 0 0-3.79 23.4c.6.11.82-.26.82-.58v-2.02c-3.34.73-4.04-1.61-4.04-1.61-.55-1.4-1.34-1.77-1.34-1.77-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5 1 .11-.78.42-1.3.76-1.6-2.66-.3-5.46-1.33-5.46-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.17 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.24 2.87.12 3.17.77.84 1.24 1.91 1.24 3.22 0 4.61-2.8 5.62-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.82.58A12 12 0 0 0 12 .3z" />
                        </svg>
                    }
                    <span>Sign in with @Model.ProviderDisplayName</span>
                </button>
            </form>
        }
        else
        {
            <p class="mb-5 text-fg-secondary" role="status">
                Sign-in is not configured for this feed. Ask an administrator to enable
                Microsoft, Google, or GitHub authentication.
            </p>
        }
    </div>
</section>
