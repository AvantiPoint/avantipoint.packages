@page "/Account/AccessDenied"
@model AvantiPoint.Packages.Host.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
}

<section class="auth-panel" aria-labelledby="denied-title">
    <div class="auth-card">
        <p class="auth-card__eyebrow">Package Feed</p>
        <h1 id="denied-title">Access denied</h1>
        <p class="auth-card__lead">You are not authorized to sign in to this feed with the account you used.</p>
        <p class="auth-card__copy">Microsoft sign-in requires an organizational tenant configured by your administrator. Google sign-in requires a Workspace domain, and GitHub sign-in requires organization membership.</p>
        <p><a class="feed-header__action feed-header__action--primary" href="/Account/Login">Try again</a></p>
    </div>
</section>
