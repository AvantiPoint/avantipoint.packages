@page "/Account/AccessDenied"
@model AvantiPoint.Packages.Host.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
}

<section class="flex min-h-[calc(100vh-8rem)] items-start justify-center px-0 py-8 pb-16 max-md:min-h-0 max-md:pt-4" aria-labelledby="denied-title">
    <div class="w-full max-w-md rounded-2xl border border-border bg-panel px-7 py-8 shadow-pkg max-md:px-[1.15rem] max-md:py-6">
        <p class="mb-1.5 text-xs font-bold uppercase tracking-[0.08em] text-muted">Package Feed</p>
        <h1 id="denied-title" class="mb-2">Access denied</h1>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <p class="mb-5 text-fg-secondary">Your account does not have permission to access this page.</p>
            <p class="mb-5 text-fg-secondary">Contact a feed administrator if you need additional access.</p>
            <p><a href="~/browse">Return to packages</a></p>
        }
        else
        {
            <p class="mb-5 text-fg-secondary">We could not authorize this account to access the feed.</p>
            <p class="mb-5 text-fg-secondary">Sign in with your organization's account, or ask a feed administrator to check your approval and access settings.</p>
        }
        <p>
            <a class="inline-flex items-center justify-center rounded-full border border-brand bg-brand px-3.5 py-1.5 text-sm font-semibold text-brand-on no-underline hover:bg-brand-strong hover:text-brand-on" href="~/Account/Login">Try again</a>
        </p>
    </div>
</section>
