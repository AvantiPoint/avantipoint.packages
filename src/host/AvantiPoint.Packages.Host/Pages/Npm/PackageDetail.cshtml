@page "/browse/npm/packages/{**PackageName}"
@using AvantiPoint.Feed.Platform
@using AvantiPoint.Packages.UI.Components.Npm
@model AvantiPoint.Packages.Host.Pages.Npm.PackageDetailModel
@{
    ViewData["Title"] = Model.PageTitle;
}

@(await Html.RenderComponentAsync<NpmPackageDetailLoader>(
    RenderMode.ServerPrerendered,
    new
    {
        Model.PackageName,
        Model.RegistryUrl,
        RequestedVersion = Model.Version,
        RequestedCompareVersion = Model.Compare,
        Model.SelectedFile,
    }))

@section Scripts {
}
